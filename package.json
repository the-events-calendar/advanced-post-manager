{
  "name": "advanced-post-manager",
  "version": "4.5.8",
  "repository": "git@github.com:the-events-calendar/advanced-post-manager.git",
  "_zipname": "advanced-post-manager",
  "_zipfoldername": "advanced-post-manager",
  "_resourcepath": "src/resources",
  "_domainPath": "lang",
  "_textDomain": "advanced-post-manager",
  "_glotPressUrl": "https://translations.theeventscalendar.com",
  "_glotPressSlug": "tribe-apm",
  "_glotPressFileFormat": "%textdomain%-%wp_locale%.%format%",
  "_glotPressFormats": [
    "po",
    "mo"
  ],
  "_glotPressFilter": {
    "translation_sets": false,
    "minimum_percentage": 30,
    "waiting_strings": false
  },
  "engines": {
    "node": "18.13.0",
    "npm": "8.19.0"
  },
  "devDependencies": {
    "@stellarwp/changelogger": "^0.10.0",
    "@the-events-calendar/product-taskmaster": "^3.0.0",
    "archiver": "^0.10.1",
    "glob": "~4.0.5",
    "gulp": "^4.0.2",
    "require-dir": "^0.3.0"
  },
  "scripts": {
    "changelog": "npx @stellarwp/changelogger add"
  },
  "changelogger": {
    "changelogFile": "changelog.md",
    "changesDir": "changelog",
    "ordering": [
      "type",
      "content"
    ],
    "types": {
      "version": "Version",
      "performance": "Performance",
      "accessibility": "Accessibility"
    },
    "versioning": "./bin/tec-changelog-versioning.js",
    "files": [
      {
        "path": "changelog.md",
        "strategy": "stellarwp-changelog"
      },
      {
        "path": "readme.txt",
        "strategy": "stellarwp-readme"
      }
    ]
  }
}
